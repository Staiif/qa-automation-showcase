{
  "name": "@taskly/selenium-e2e",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Selenium WebDriver E2E suite (JS) for Taskly — Page Object parity with the Playwright suite, on the same @taskly/e2e-core toolkit.",
  "scripts": {
    "test": "mocha",
    "test:headed": "HEADLESS=0 mocha",
    "test:report": "mocha --reporter mochawesome --reporter-options reportDir=reports,reportFilename=index,html=true,json=false,overwrite=true,quiet=true"
  },
  "dependencies": {
    "@taskly/e2e-core": "*"
  },
  "devDependencies": {
    "chai": "5.1.2",
    "dotenv": "16.6.1",
    "mocha": "10.8.2",
    "mochawesome": "7.1.3",
    "selenium-webdriver": "4.27.0"
  }
}
